# Optional: explicit proxy URL (user:pass@host:port). If unset, falls back
# to WEBSHARE_PROXY_USERNAME/PASSWORD below against Webshare's standard
# rotating gateway.
PROXY_URL=http://user:pass@gateway.example.com:port

# Webshare residential proxy credentials (used if PROXY_URL is unset)
WEBSHARE_PROXY_USERNAME=your_webshare_username
WEBSHARE_PROXY_PASSWORD=your_webshare_password

# faster-whisper model size (tiny, base, small, medium, large-v3)
WHISPER_MODEL=base
